{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.8.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["<all_urls>", "file:///*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>", "file:///*"],
      "js": ["vendor/gifuct-js.js", "content.js"],
      "css": ["viewer.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["gif-worker.js", "vendor/gifuct-js.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/gif-16.png",
      "32": "icons/gif-32.png",
      "48": "icons/gif-48.png",
      "128": "icons/gif-128.png"
    }
  },
  "icons": {
    "16": "icons/gif-16.png",
    "32": "icons/gif-32.png",
    "48": "icons/gif-48.png",
    "128": "icons/gif-128.png"
  }
}
